{
  "name": "fibonacci-calculator-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm --enable-source-maps src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "build-and-start": "cd .. && npm run build && cd server && npm run build && npm run start:prod",
    "test": "vitest --config vitest.config.js"
  },
  "dependencies": {
    "express": "^4.18.4",
    "express-rate-limit": "^6.7.0",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.5.0",
    "nodemon": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.0",
    "vitest": "^1.0.0",
    "supertest": "^6.3.3"
  }
}
